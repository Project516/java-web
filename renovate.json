{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Temurin JDK 25 release scripts/build-jdk.sh downloads",
      "managerFilePatterns": ["/^scripts/build-jdk\\.sh$/"],
      "matchStrings": ["\\nrelease=(?<currentValue>\\S+)\\n"],
      "depNameTemplate": "temurin-jdk-25",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "adoptium/temurin25-binaries",
      "extractVersionTemplate": "^jdk-(?<version>\\d+\\.\\d+\\.\\d+(\\.\\d+)?\\+\\d+)$",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?\\+(?<revision>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "The build tools (TypeScript, esbuild, Node types) move together in one weekly PR",
      "groupName": "build tools",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
